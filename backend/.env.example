# CallScribe Backend Configuration
APP_NAME=CallScribe API
APP_ENV=development
LOG_LEVEL=INFO

# Server bind settings
HOST=0.0.0.0
PORT=8000

# SQLite database URL (relative paths resolve inside backend/)
DATABASE_URL=sqlite:///./data/callscribe.db

# Private filesystem directory for uploaded media files (never exposed publicly)
UPLOAD_DIR=./storage/uploads

# Maximum upload size in bytes (default: 2 GB = 2147483648)
MAX_UPLOAD_BYTES=2147483648

# Phase 2 AI pipeline toggle (false in Phase 1 -> honest terminal error instead of endless polling)
AI_PROVIDER_ENABLED=false

# Comma-separated allowed CORS origins for the CallScribe frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
